{
    // PlatformIO settings
    "platformio-ide.useBuiltinPIOCore": true,
    "platformio-ide.autoCleanBeforeBuild": false,
    
    // File associations
    "files.associations": {
        "*.ino": "cpp",
        "mcp_can.h": "c",
        "mcp_can.cpp": "cpp",
        "can-232.h": "c",
        "can-232.cpp": "cpp"
    },
    
    // Editor settings
    "editor.formatOnSave": false,
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    
    // C/C++ settings - use clangd for Arduino projects
    "C_Cpp.intelliSenseEngine": "disabled",
    // clangd.path removed - let the clangd extension manage it automatically
    
    // Exclude build artifacts from file explorer
    "files.exclude": {
        "**/.pio": true,
        "**/.pioenvs": true,
        "**/.piolibdeps": true
    },
    
    // Search exclusions
    "search.exclude": {
        "**/.pio": true,
        "**/.pioenvs": true,
        "**/.piolibdeps": true
    },
    
    // Git settings - enable Git functionality
    "git.enabled": true,
    "git.autoRepositoryDetection": true,
    
    // GitLens settings - enable context menu items including "Add to .gitignore"
    "gitlens.menus": {
        "explorer": {
            "file": true,
            "folder": true
        },
        "scm": {
            "file": true,
            "folder": true
        },
        "editor": {
            "file": true
        }
    },
    "gitlens.menus.file": true,
    "gitlens.menus.folder": true,
    "gitlens.menus.explorer": true,
    "gitlens.menus.scm": true,
    "gitlens.menus.editor": true,
    
    // PowerShell settings - suppress errors in WSL workspace (scripts are for Windows only)
    // Note: PowerShell extension will still work normally in Windows workspaces
    // To disable PowerShell extension in this WSL workspace only:
    // 1. Press Ctrl+Shift+X to open Extensions
    // 2. Search for "PowerShell"
    // 3. Click the gear icon → "Disable (Workspace)"
    "powershell.powerShellAdditionalExePaths": {},
    "powershell.enableProfileLoading": false,
    // Suppress PowerShell not found errors in WSL
    "powershell.integratedConsole.showOnStartup": false
}

