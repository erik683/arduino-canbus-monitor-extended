{
    // PlatformIO settings
    "platformio-ide.useBuiltinPIOCore": true,
    "platformio-ide.autoCleanBeforeBuild": false,
    
    // File associations
    "files.associations": {
        "*.ino": "cpp",
        "mcp_can.h": "c",
        "mcp_can.cpp": "cpp",
        "can-232.h": "c",
        "can-232.cpp": "cpp"
    },
    
    // Editor settings
    "editor.formatOnSave": false,
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    
    // C/C++ settings
    "C_Cpp.intelliSenseEngine": "default",
    
    // Exclude build artifacts from file explorer
    "files.exclude": {
        "**/.pio": true,
        "**/.pioenvs": true,
        "**/.piolibdeps": true
    },
    
    // Search exclusions
    "search.exclude": {
        "**/.pio": true,
        "**/.pioenvs": true,
        "**/.piolibdeps": true
    }
}

